# YYC³ Bot 环境变量配置
# 复制此文件为 .env.local 并填入实际值

# ---- AI 提供商 ----
# 智谱 AI API Key（https://open.bigmodel.cn）
ZHIPU_API_KEY=your_zhipu_api_key_here
# 智谱 API 基础 URL（默认 https://open.bigmodel.cn/api/paas/v4）
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Ollama 本地服务地址（默认 http://localhost:11434）
OLLAMA_BASE_URL=http://localhost:11434

# ---- 数据库（PostgreSQL）----
# 主数据库（MCP 服务管理）
DATABASE_URL=postgresql://yanyu@localhost:5433/yyc3_mcp
# 核心数据库（可选）
DATABASE_CORE_URL=postgresql://yanyu@localhost:5433/yyc3_core
# Aify 数据库（可选）
DATABASE_AIFY_URL=postgresql://yanyu@localhost:5433/yyc3_aify
# API 数据库（可选）
DATABASE_API_URL=postgresql://yanyu@localhost:5433/yyc3_api
